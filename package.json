{
  "name": "agent-orrery",
  "version": "0.1.0",
  "description": "Lightweight persistent universe visualization of Claude Code agents. Projects are solar systems, agents are starships.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup.mjs",
    "shots": "electron . --shots",
    "ships:generate": "node scripts/generate-original-ship.mjs && node scripts/generate-vanta-seraph.mjs && node scripts/generate-fleet-ships.mjs",
    "ships:generate:aster": "node scripts/generate-original-ship.mjs",
    "ships:generate:flagship": "node scripts/generate-vanta-seraph.mjs",
    "ships:generate:fleet": "node scripts/generate-fleet-ships.mjs",
    "status:lab": "electron scripts/project-vcs-status-lab.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "postinstall": "install-electron"
  },
  "author": "matt",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.8.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "babylonjs": "^9.30.0",
    "babylonjs-gui": "^9.30.0",
    "babylonjs-loaders": "9.30.0"
  }
}
